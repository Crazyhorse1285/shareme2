# ShareMe environment variables
# 1. Copy this file to .env:   copy .env.example .env
# 2. Replace re_xxxxxxxxxx below with your actual Resend API key

# Resend API key (required for password reset emails)
# Get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx

# Base URL for reset links (default: http://localhost:3000)
# In production: https://yourdomain.com
BASE_URL=http://localhost:3000

# From address for password reset emails (default: ShareMe <onboarding@resend.dev>)
# Use a verified domain for production: ShareMe <noreply@yourdomain.com>
RESEND_FROM=ShareMe <notice1285@gmail.com>

# Stripe (optional — Pro upgrade is disabled if not set)
# Create a Product and one-time Price in Stripe Dashboard, then set:
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxx
# Webhook: Stripe CLI or Dashboard → Developers → Webhooks → Add endpoint /api/webhooks/stripe, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx
